{
  "name": "slidev-polls-frontends",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "shared",
    "voter",
    "backoffice",
    "slidev-component",
    "slidev-demo"
  ],
  "scripts": {
    "test": "bun --filter='*' run test",
    "build": "bun --filter='*' run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{ts,vue,json,md,yml,yaml,html,css}\"",
    "format:write": "prettier --write \"**/*.{ts,vue,json,md,yml,yaml,html,css}\"",
    "e2e": "playwright test",
    "e2e:install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2",
    "vue-eslint-parser": "^10.4.0"
  }
}
