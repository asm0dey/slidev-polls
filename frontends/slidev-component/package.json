{
  "name": "@slidev-polls/component",
  "version": "0.0.1",
  "type": "module",
  "description": "Slidev addon that renders live poll results on-slide.",
  "license": "GPL-3.0-or-later",
  "author": "Pasha FInkelshteyn <pavel.finkelshtein@gmail.com>",
  "homepage": "https://github.com/asm0dey/slidev-polls#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asm0dey/slidev-polls.git",
    "directory": "frontends/slidev-component"
  },
  "bugs": {
    "url": "https://github.com/asm0dey/slidev-polls/issues"
  },
  "keywords": [
    "slidev",
    "slidev-addon",
    "polls",
    "voting",
    "presentation"
  ],
  "main": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "slidev": {
    "defaults": {}
  },
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config=../playwright.config.ts --project=slidev-chromium",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@slidev-polls/shared": "workspace:*",
    "qr-code-styling": "^1.9.2"
  },
  "peerDependencies": {
    "@slidev/client": "^52.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@slidev/client": "^52.15.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^30.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
