# Keep the Docker build context slim and reproducible.
# We deliberately DO include backend/**/target/generated-sources/jooq because
# the backend-builder stage expects codegen to have run on the host first
# (see scripts/dev-up.sh and the README "Run everything in Docker" section).

# Node / bun artefacts — regenerated inside the frontends-builder stage.
**/node_modules/
**/.vite/
**/.bun/
**/dist/

# Maven build outputs — regenerated inside the backend-builder stage.
backend/*/target/classes/
backend/*/target/test-classes/
backend/*/target/maven-archiver/
backend/*/target/maven-status/
backend/*/target/surefire-reports/
backend/*/target/failsafe-reports/
backend/*/target/spotless-index
backend/*/target/generated-test-sources/
backend/*/target/*.jar
backend/*/target/*.original

# IDE / OS cruft
.idea/
.vscode/
*.iml
.DS_Store

# Feature artefacts and local session state — never needed at build time.
.specify/dashboard.html
.claude/
test-results/
frontends/test-results/
.git/
