# Keep the Docker build context slim and reproducible.
# We deliberately DO include target/generated-sources/jooq because the
# backend-builder stage expects codegen to have run on the host first
# (see Taskfile `codegen` target and the README "Run everything in Docker"
# section).

# Node / bun artefacts — regenerated inside the frontends-builder stage.
**/node_modules/
**/.vite/
**/.bun/
**/dist/

# Maven build outputs — regenerated inside the backend-builder stage.
target/classes/
target/test-classes/
target/maven-archiver/
target/maven-status/
target/surefire-reports/
target/failsafe-reports/
target/spotless-index
target/generated-test-sources/
target/*.jar
target/*.original

# IDE / OS cruft
.idea/
.vscode/
*.iml
.DS_Store

# Feature artefacts and local session state — never needed at build time.
.specify/dashboard.html
.claude/
test-results/
frontends/test-results/
.git/
