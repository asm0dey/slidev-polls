<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>site.asm0dey.slidev.polls</groupId>
        <artifactId>slidev-polls-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>poll-persistence</artifactId>
    <name>poll-persistence</name>
    <description>jOOQ repositories, Flyway migrations, PostgreSQL mappers. Owns the schema.</description>

    <dependencies>
        <dependency>
            <groupId>site.asm0dey.slidev.polls</groupId>
            <artifactId>poll-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <!--
          Jackson 3 (tools.jackson.*) for JSONB (de)serialisation in PollRepositoryImpl.
          Spring Boot 4 auto-configures this ObjectMapper in the application context;
          poll-persistence declares it here so the generated jOOQ repository code
          can compile and link against the same type at runtime.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <!--
          Flyway is pulled in through Spring Boot 4's dedicated starter rather
          than via `flyway-core` directly. In Spring Boot 4 the Flyway
          auto-configuration lives in `spring-boot-flyway` (not in
          `spring-boot-autoconfigure` as it did in 3.x); the starter bundles
          that auto-configuration alongside `flyway-core`, so migrations
          actually run on application startup. `flyway-database-postgresql`
          is still required explicitly under Flyway 10+/11+ to register the
          Postgres dialect.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
      Codegen target — the dev Postgres from the repo's docker-compose.yml,
      isolated to a dedicated `polls_codegen` schema so flyway:clean doesn't
      wipe anything an author cares about in `public`. Contributors override
      these if they run Postgres elsewhere.
    -->
    <properties>
        <db.url>jdbc:postgresql://localhost:5432/polls</db.url>
        <db.username>polls</db.username>
        <db.password>polls</db.password>
        <db.codegen.schema>polls_codegen</db.codegen.schema>
        <postgresql.version>42.7.11</postgresql.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <!--
              jOOQ sources are regenerated from the Flyway-owned schema on
              demand via the `codegen` profile: `docker compose up -d postgres`
              once, then `./mvnw -Pcodegen -pl backend/poll-persistence -am
              generate-sources` whenever migrations change. Keeping the codegen
              chain inside a profile means a fresh clone can compile poll-core,
              poll-realtime, and poll-api without a live Postgres; only the
              repository layer in poll-persistence needs the generated classes,
              and anyone touching repository code already has Postgres up for
              the tests.

              build-helper-maven-plugin attaches the on-disk codegen output
              to every invocation's compile source roots. The codegen profile
              *produces* those sources; this plugin *wires* them to the
              compiler so a plain `./mvnw -pl backend/poll-persistence -am
              compile` picks them up without a `-Pcodegen` re-run each time.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-jooq-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>codegen</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-maven-plugin</artifactId>
                        <version>${flyway.version}</version>
                        <executions>
                            <execution>
                                <id>codegen-migrate</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>clean</goal>
                                    <goal>migrate</goal>
                                </goals>
                                <configuration>
                                    <url>${db.url}</url>
                                    <user>${db.username}</user>
                                    <password>${db.password}</password>
                                    <schemas>
                                        <schema>${db.codegen.schema}</schema>
                                    </schemas>
                                    <defaultSchema>${db.codegen.schema}</defaultSchema>
                                    <createSchemas>true</createSchemas>
                                    <cleanDisabled>false</cleanDisabled>
                                    <locations>
                                        <location>filesystem:src/main/resources/db/migration</location>
                                    </locations>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.flywaydb</groupId>
                                <artifactId>flyway-database-postgresql</artifactId>
                                <version>${flyway.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${postgresql.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                    <plugin>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen-maven</artifactId>
                        <version>${jooq.version}</version>
                        <executions>
                            <execution>
                                <id>codegen-generate</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <jdbc>
                                        <driver>org.postgresql.Driver</driver>
                                        <url>${db.url}</url>
                                        <user>${db.username}</user>
                                        <password>${db.password}</password>
                                    </jdbc>
                                    <generator>
                                        <database>
                                            <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                            <!--
                                              Explicit include list rather than `.*`: V3 enables
                                              pgcrypto, and the extension's functions/tables land in
                                              whichever schema Flyway is migrating — for codegen
                                              that's `polls_codegen`, so `.*` would drag in Armor,
                                              Crypt, GenSalt, PgpArmorHeaders, and friends. Listing
                                              our six tables keeps the generated namespace free of
                                              pgcrypto noise without having to maintain a brittle
                                              exclude regex against every pgcrypto release.
                                            -->
                                            <includes>admin_user|polls|poll_questions|poll_options|votes|deck_tokens</includes>
                                            <!--
                                              Codegen runs against a disposable `polls_codegen`
                                              schema, but the generated classes live above the
                                              schema boundary: production uses `public`, every
                                              integration test uses a fresh Flyway-owned database
                                              whose default schema is `public`. `outputSchemaToDefault`
                                              tells jOOQ to emit classes that do NOT qualify the
                                              schema, so the generated `POLLS` table reference
                                              resolves against whatever schema is on the session
                                              search_path — no render-schema toggles required at
                                              runtime.
                                            -->
                                            <schemata>
                                                <schema>
                                                    <inputSchema>${db.codegen.schema}</inputSchema>
                                                    <outputSchemaToDefault>true</outputSchemaToDefault>
                                                </schema>
                                            </schemata>
                                        </database>
                                        <target>
                                            <packageName>site.asm0dey.slidev.polls.persistence.jooq</packageName>
                                            <directory>${project.build.directory}/generated-sources/jooq</directory>
                                        </target>
                                    </generator>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${postgresql.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
