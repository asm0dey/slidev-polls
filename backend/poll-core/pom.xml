<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>site.asm0dey.slidev.polls</groupId>
        <artifactId>slidev-polls-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>poll-core</artifactId>
    <name>poll-core</name>
    <description>Domain model, services, and validation. No Spring Web, no JDBC.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <!--
          spring-tx carries @Transactional; PollService and later VoteService
          span multi-statement operations (poll + questions + options insert,
          atomic activate+close) and have to declare the transactional
          boundary on the service method. spring-context does NOT drag
          spring-tx transitively.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!--
          spring-security-crypto carries the PasswordEncoder interface that
          AdminUserService depends on (so the bootstrap and create-admin flows
          can hash passwords without leaking algorithm choice into core).
          We pull only the crypto module — the full spring-security-core /
          spring-boot-starter-security stack stays out of poll-core to keep
          the module web/auth-free. Recorded under Constitution §VIII:
          justified by the admin-credentials redesign at
          docs/superpowers/specs/2026-05-09-replace-hardcoded-admin-credentials-design.md.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
