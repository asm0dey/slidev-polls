<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>site.asm0dey.slidev.polls</groupId>
    <artifactId>slidev-polls</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>slidev-polls</name>
    <description>Slidev Polls — unified Spring Boot application</description>
    <url>https://github.com/asm0dey/slidev-polls</url>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>asm0dey</id>
            <name>Pavel Finkelshtein</name>
            <email>pavel.finkelshtein@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/asm0dey/slidev-polls.git</connection>
        <developerConnection>scm:git:git@github.com:asm0dey/slidev-polls.git</developerConnection>
        <url>https://github.com/asm0dey/slidev-polls</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <db.codegen.schema>polls_codegen</db.codegen.schema>
        <postgresql.version>42.7.13</postgresql.version>
        <testcontainers-jooq-codegen-maven-plugin.version>1.0.0</testcontainers-jooq-codegen-maven-plugin.version>
    </properties>

    <dependencies>
        <!-- Web + security + validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Argon2PasswordEncoder (SecurityConfig#passwordEncoder) delegates
          to org.bouncycastle.crypto.generators.Argon2BytesGenerator.
          Spring Security ships the encoder but not the BC primitive.
          Recorded under Constitution §VIII: justified by the
          password-hashing upgrade documented in
          docs/superpowers/specs/2026-05-09-replace-hardcoded-admin-credentials-design.md.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.85</version>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <!--
              H2 is on the compile classpath (rather than runtime) because
              site.asm0dey.slidev.polls.persistence.h2.TouchPollUpdatedAtTrigger
              implements org.h2.api.Trigger and is referenced by name from the
              H2 migration that creates the poll_questions_touch_polls trigger.
            -->
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Session -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- QR generation -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.4</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>site.asm0dey.slidev.polls.api.PollApiApplication</mainClass>
                </configuration>
            </plugin>

            <!--
              Spotless: google-java-format on every Java source, applied at
              `verify` so `./mvnw verify` fails loud on a drifted format.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.10.2</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.28.0</version>
                            <style>GOOGLE</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!--
              Failsafe runs `*IT.java` at integration-test / verify. Spring
              Boot's parent only manages the version; binding lives here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-it</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              build-helper attaches the on-disk jOOQ codegen output to every
              invocation's compile source roots. The `codegen` profile produces
              the sources; this plugin wires them to the compiler so a plain
              `./mvnw compile` picks them up without re-running codegen each
              time.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-jooq-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>codegen</id>
            <build>
                <plugins>
                    <!--
                      testcontainers-jooq-codegen-maven-plugin spins up a
                      throwaway Postgres, runs Flyway, then jOOQ codegen.
                      Docker on PATH is the only prerequisite.
                    -->
                    <plugin>
                        <groupId>dev.sivalabs</groupId>
                        <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                        <version>${testcontainers-jooq-codegen-maven-plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.testcontainers</groupId>
                                <artifactId>testcontainers-postgresql</artifactId>
                                <version>${testcontainers.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.postgresql</groupId>
                                <artifactId>postgresql</artifactId>
                                <version>${postgresql.version}</version>
                            </dependency>
                            <!--
                              Pin jOOQ tooling to the runtime BOM (3.19.32).
                              The plugin defaults to a newer codegen that
                              emits symbols absent from the runtime jar.
                            -->
                            <dependency>
                                <groupId>org.jooq</groupId>
                                <artifactId>jooq</artifactId>
                                <version>${jooq.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.jooq</groupId>
                                <artifactId>jooq-meta</artifactId>
                                <version>${jooq.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>org.jooq</groupId>
                                <artifactId>jooq-codegen</artifactId>
                                <version>${jooq.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>codegen-generate</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <database>
                                        <type>POSTGRES</type>
                                        <containerImage>postgres:18</containerImage>
                                    </database>
                                    <flyway>
                                        <defaultSchema>${db.codegen.schema}</defaultSchema>
                                        <schemas>${db.codegen.schema}</schemas>
                                        <createSchemas>true</createSchemas>
                                        <!--
                                          The plugin's FlywayRunner extends HashMap<String,String>
                                          so Flyway config must be passed as flat scalar properties.
                                          Nested <location> children are silently dropped by Plexus,
                                          which lets the plugin's default `classpath:/db/migration`
                                          win and recursively scan every vendor subdirectory
                                          (postgresql/, h2/) — producing duplicate V1 migrations.
                                          Use the comma-separated string form so `flyway.locations`
                                          is set explicitly and the default is suppressed.
                                        -->
                                        <locations>filesystem:src/main/resources/db/migration/postgresql,filesystem:src/main/resources/db/migration/common</locations>
                                    </flyway>
                                    <jooq>
                                        <generator>
                                            <database>
                                                <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                                <includes>admin_user|polls|poll_questions|poll_options|poll_allowed_origins|poll_collaborators|votes|deck_tokens</includes>
                                                <schemata>
                                                    <schema>
                                                        <inputSchema>${db.codegen.schema}</inputSchema>
                                                        <outputSchemaToDefault>true</outputSchemaToDefault>
                                                    </schema>
                                                </schemata>
                                            </database>
                                            <target>
                                                <packageName>site.asm0dey.slidev.polls.persistence.jooq</packageName>
                                                <directory>${project.build.directory}/generated-sources/jooq</directory>
                                            </target>
                                        </generator>
                                    </jooq>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
