<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>site.asm0dey.slidev.polls</groupId>
    <artifactId>slidev-polls</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>slidev-polls</name>
    <description>Slidev Polls — unified Quarkus application</description>
    <url>https://github.com/asm0dey/slidev-polls</url>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 or later</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>asm0dey</id>
            <name>Pavel Finkelshtein</name>
            <email>pavel.finkelshtein@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/asm0dey/slidev-polls.git</connection>
        <developerConnection>scm:git:git@github.com:asm0dey/slidev-polls.git</developerConnection>
        <url>https://github.com/asm0dey/slidev-polls</url>
    </scm>

    <properties>
        <!--
          Build with JDK 25 (SDKMAN current) but emit Java 21 bytecode: Quarkus
          3.15 LTS augmentation uses an ASM that cannot read class-file major 69
          (Java 25). The JRE-25 runtime image runs 21 bytecode fine; only Java
          22-25 *language* features are off the table. (Quarkus is no longer pinned
          to 3.15 by quarkus-jooq, which was dropped — a future Quarkus upgrade
          could restore a 25 target, but that flips Jackson 2->3 and changes the
          security HttpAuthenticationMechanism APIs, so it is out of scope here.)
        -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!--
          Quarkus 3.15.x is the LTS line that quarkiverse quarkus-jooq 2.1.0 was
          built against (its parent pins quarkus.version=3.15.1); 3.15.7 is the
          latest LTS patch and stays API-compatible with the extension's core
          deps (agroal, narayana-jta, arc).
        -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.15.7</quarkus.platform.version>
        <quarkus-jooq.version>2.1.0</quarkus-jooq.version>

        <!--
          jOOQ runtime version shipped by quarkus-jooq 2.1.0 (its parent pins
          org.jooq.version=3.19.22). The codegen profile below references
          ${jooq.version}; runtime and codegen MUST agree to avoid the symbol
          drift the codegen plugin defaults to (it emits newer codegen symbols
          absent from the runtime jar otherwise).
        -->
        <jooq.version>3.19.22</jooq.version>

        <db.codegen.schema>polls_codegen</db.codegen.schema>
        <!--
          jOOQ codegen runs by default at generate-sources (needs Docker). Set
          -Ddb.codegen.skip=true to skip it when the generated sources already
          exist in the build context — the container image build does this
          (it COPYs target/generated-sources and has no Docker daemon inside).
        -->
        <db.codegen.skip>false</db.codegen.skip>
        <postgresql.version>42.7.11</postgresql.version>
        <!--
          testcontainers used only by the codegen plugin's testcontainers-jooq
          plugin dependency (org.testcontainers:testcontainers-postgresql, which
          is published only in the 2.0.x line). Previously inherited from the
          Spring Boot parent; pinned explicitly now that the parent is gone.
        -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <testcontainers-jooq-codegen-maven-plugin.version>1.0.0</testcontainers-jooq-codegen-maven-plugin.version>

        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <surefire-plugin.version>3.2.5</surefire-plugin.version>
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web + JSON + validation -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-reactive-routes</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-narayana-jta</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <!--
          jOOQ runtime, used directly via a custom CDI producer (config/JooqConfig).
          The quarkiverse quarkus-jooq extension was dropped: it requires
          quarkus.jooq.dialect and always produces a @Default DSLContext bound to a
          single fixed datasource, which collides with the multi-datasource,
          runtime-vendor-selected @Default DSLContext this app needs (D1b). jOOQ's
          generated classes are registered for native reflection in Phase 8 (the only
          capability the extension provided that we still need).
        -->
        <dependency>
            <groupId>org.jooq</groupId>
            <artifactId>jooq</artifactId>
            <version>${jooq.version}</version>
        </dependency>
        <!--
          jOOQ's org.jooq.impl.Tools optionally references jakarta.persistence annotations
          (Entity/Column) for its DefaultRecordMapper JPA path. With link-at-build-time
          (the Quarkus native default) the GraalVM analysis fails on these unresolved types when
          the H2 driver's build-time initialization reaches Tools. We don't use jOOQ's JPA mapping,
          but putting the API on the classpath lets Tools link cleanly. Harmless on the JVM build.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- Security -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-elytron-security</artifactId>
        </dependency>
        <!--
          NOTE: the quarkus-rest-csrf extension was removed. Its global
          CsrfRequestResponseReactiveFilter rejects EVERY state-changing request
          that lacks its own form/cookie token — including all application/json
          POST/PUT/PATCH/DELETE — with a bare 400, and `verify-token=false` does
          not suppress that filter in 3.15. CSRF for the backoffice JSON SPA is
          enforced by the custom AdminCsrfFilter (double-submit, scoped to
          /api/admin/**), which does not need the extension.
        -->

        <!-- Scheduling -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>

        <!--
          Argon2 primitive. Argon2PasswordHasher (Phase 4) wraps
          org.bouncycastle.crypto.generators.Argon2BytesGenerator, replacing the
          old Spring Argon2PasswordEncoder. Recorded under Constitution §VIII:
          justified by the password-hashing upgrade documented in
          docs/superpowers/specs/2026-05-09-replace-hardcoded-admin-credentials-design.md.
        -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.84</version>
        </dependency>

        <!--
          QR generation. quarkus-zxing (quarkiverse quarkus-barcode 1.0.0, built against
          Quarkus 3.15.1 — API-compatible with our 3.15.7 platform) wraps ZXing with GraalVM
          native support: it pulls quarkus-awt (native-registered AWT/ImageIO) and the ZXing
          core + javase jars transitively, so QrController no longer touches raw
          MatrixToImageWriter/ImageIO/BufferedImage directly and the native image keeps the
          AWT/ImageIO codepath registered. QrController encodes via
          io.quarkiverse.barcode.zxing.ZebraCrossing. The ZXing decode classes used only by
          QrEndpointIT (MultiFormatReader, BufferedImageLuminanceSource, …) also come from this
          extension's transitive ZXing core + javase, so the raw com.google.zxing deps are dropped.
        -->
        <dependency>
            <groupId>io.quarkiverse.barcode</groupId>
            <artifactId>quarkus-zxing</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!--
          H2 is a runtime DB vendor (D1b): quarkus-jdbc-h2 (declared above with
          quarkus-jdbc-postgresql) pulls the com.h2database:h2 driver onto the
          runtime classpath, so persistence.h2.TouchPollUpdatedAtTrigger and the
          H2 migrations run at runtime, not just under test.
        -->

        <!-- Tests -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Spotless: google-java-format on every Java source, applied at
              `verify` so `./mvnw verify` fails loud on a drifted format.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.28.0</version>
                            <style>GOOGLE</style>
                            <reflowLongStrings>true</reflowLongStrings>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>

            <!--
              Surefire runs `*Test.java` at test. DOCKER_API_VERSION is pinned so the
              Testcontainers client bundled by Quarkus Dev Services (docker-java negotiates
              API 1.32 by default) talks to a modern daemon that requires API >= 1.40.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <DOCKER_API_VERSION>1.43</DOCKER_API_VERSION>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <api.version>1.43</api.version>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              Failsafe runs `*IT.java` at integration-test / verify. Same DOCKER_API_VERSION
              pin as surefire for Quarkus Dev Services.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <DOCKER_API_VERSION>1.43</DOCKER_API_VERSION>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <api.version>1.43</api.version>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>default-it</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              jOOQ codegen runs by default at generate-sources so a plain
              `./mvnw clean package` / `verify` regenerates the generated sources
              (Docker required). Skipped via -Ddb.codegen.skip=true when sources
              are pre-supplied (the container image build COPYs them).
              testcontainers-jooq-codegen spins up a throwaway Postgres, runs
              Flyway, then jOOQ codegen.
            -->
            <plugin>
                <groupId>dev.sivalabs</groupId>
                <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                <version>${testcontainers-jooq-codegen-maven-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers-postgresql</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <!--
                      Pin jOOQ tooling to the runtime version (3.19.22). The
                      plugin defaults to a newer codegen that emits symbols
                      absent from the runtime jar.
                    -->
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-meta</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>codegen-generate</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <skip>${db.codegen.skip}</skip>
                            <database>
                                <type>POSTGRES</type>
                                <containerImage>postgres:18</containerImage>
                            </database>
                            <flyway>
                                <defaultSchema>${db.codegen.schema}</defaultSchema>
                                <schemas>${db.codegen.schema}</schemas>
                                <createSchemas>true</createSchemas>
                                <!--
                                  The plugin's FlywayRunner extends HashMap<String,String>
                                  so Flyway config must be passed as flat scalar properties.
                                  Nested <location> children are silently dropped by Plexus,
                                  which lets the plugin's default `classpath:/db/migration`
                                  win and recursively scan every vendor subdirectory
                                  (postgresql/, h2/) — producing duplicate V1 migrations.
                                  Use the comma-separated string form so `flyway.locations`
                                  is set explicitly and the default is suppressed.
                                -->
                                <locations>filesystem:src/main/resources/db/migration/postgresql,filesystem:src/main/resources/db/migration/common</locations>
                            </flyway>
                            <jooq>
                                <generator>
                                    <database>
                                        <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                        <includes>admin_user|polls|poll_questions|poll_options|poll_allowed_origins|votes|deck_tokens</includes>
                                        <schemata>
                                            <schema>
                                                <inputSchema>${db.codegen.schema}</inputSchema>
                                                <outputSchemaToDefault>true</outputSchemaToDefault>
                                            </schema>
                                        </schemata>
                                    </database>
                                    <target>
                                        <packageName>site.asm0dey.slidev.polls.persistence.jooq</packageName>
                                        <directory>${project.build.directory}/generated-sources/jooq</directory>
                                    </target>
                                </generator>
                            </jooq>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              build-helper attaches the on-disk jOOQ codegen output to the
              compile source roots so the compiler picks them up.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-jooq-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          jOOQ codegen now runs by default in the main build (see the
          testcontainers-jooq-codegen-maven-plugin above). This profile is kept
          as a no-op so existing `-Pcodegen` invocations (CI steps, Taskfile,
          docs) still resolve; it adds nothing because codegen is already on the
          default lifecycle. Disable codegen with -Ddb.codegen.skip=true.
        -->
        <profile>
            <id>codegen</id>
        </profile>

        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
            </properties>
        </profile>
    </profiles>
</project>
