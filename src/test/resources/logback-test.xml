<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only logback config. Plain console pattern (no ECS JSON) plus DEBUG-level
  logging on org.jooq.tools.LoggerListener so test runs print every executed
  query, its bind values, and the fetched result. Picked up automatically because
  logback-test.xml on the classpath takes precedence over logback.xml. Works for
  both Spring Boot @SpringBootTest tests and plain JUnit tests that bypass
  Spring's logging system (e.g., AbstractPostgresTest-driven repo tests).
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.jooq.tools.LoggerListener" level="DEBUG"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
